generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  AGENT
}

enum LeadStatus {
  NEW
  CONTACTED
  NO_ANSWER
  APPOINTMENT_BOOKING
  SOLD
  NOT_INTERESTED
}

enum NotificationType {
  LEADS_ASSIGNED
  GOAL_ACHIEVED
}

enum LeadType {
  VETERANS_FINAL_EXPENSE
  MORTGAGE_PROTECTION
}

enum PolicyStatus {
  SUBMITTED
  ISSUED
  CHARGEBACK
}

enum GoalCategory {
  MONTHLY_AP
  ANNUAL_AP
  ISSUED_PREMIUM
  POLICY_COUNT
  INCOME
  RECRUITING
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  passwordHash          String?
  name                  String
  role                  Role      @default(AGENT)
  licensedStates        String[]  @default([])
  active                Boolean   @default(true)
  profileImageUrl       String?
  compLevel             String?
  vaultEnabled          Boolean   @default(true)
  assignmentEnabled     Boolean   @default(true)
  npn                   String?
  residentState         String?
  managerId             String?
  manager               User?     @relation("ManagerHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  inviteTokenHash       String?   @unique
  inviteTokenExpiresAt  DateTime?
  invitedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  downlines         User[]              @relation("ManagerHierarchy")
  assignedLeads     Lead[]              @relation("AssignedLeads")
  notes             LeadNote[]
  contactLogEntries ContactLogEntry[]
  imports           Import[]
  notifications     Notification[]
  assignmentFlags   AssignmentRunFlag[]
  trainingProgress  TrainingProgress[]
  policies          Policy[]            @relation("AgentPolicies")
  goals             Goal[]
  policyStatusChanges PolicyStatusHistory[] @relation("PolicyStatusChangedBy")
  chatMessages      ChatMessage[]
  chatReads         ChatRead[]
  chatReactions     ChatReaction[]
  chatPins          ChatMessage[]  @relation("ChatPinnedBy")
  chatChannelMemberships ChatChannelMember[]

  @@map("users")
}

model Lead {
  id              String     @id @default(cuid())
  firstName       String
  lastName        String
  phone           String
  dateOfBirth     DateTime
  state           String
  leadType        LeadType   @default(VETERANS_FINAL_EXPENSE)
  status          LeadStatus @default(NEW)
  isArchived      Boolean    @default(false)
  isVaulted       Boolean    @default(false)
  vaultOrigin     Boolean    @default(false)
  wasRecycled     Boolean    @default(false)
  assignedAgentId String?
  assignedAgent   User?      @relation("AssignedLeads", fields: [assignedAgentId], references: [id])
  assignedAt      DateTime?
  sourceImportId  String?
  sourceImport    Import?    @relation(fields: [sourceImportId], references: [id])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  notes             LeadNote[]
  contactLogEntries ContactLogEntry[]
  policies          Policy[]

  @@index([state])
  @@index([status])
  @@index([assignedAgentId])
  @@index([isArchived])
  @@index([assignedAgentId, status])
  @@index([leadType])
  @@index([isVaulted])
  @@index([vaultOrigin, status])
  @@index([wasRecycled])
  @@map("leads")
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())

  @@index([leadId])
  @@map("lead_notes")
}

// Auto-created whenever an agent marks a lead Contacted, No Answer, or Not
// Interested — a visible, append-only record of who touched a shared vault
// lead and when, so agents don't spam-call someone another agent already
// tried. Written regardless of vault state (harmless once a lead is
// privately claimed, still useful as a history).
model ContactLogEntry {
  id        String     @id @default(cuid())
  leadId    String
  lead      Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agentId   String?
  agent     User?      @relation(fields: [agentId], references: [id], onDelete: SetNull)
  status    LeadStatus
  createdAt DateTime   @default(now())

  @@index([leadId, createdAt])
  @@map("contact_log_entries")
}

model Import {
  id           String   @id @default(cuid())
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  filename     String
  rowCount     Int
  leadType     LeadType @default(VETERANS_FINAL_EXPENSE)
  createdAt    DateTime @default(now())

  leads Lead[]

  @@map("imports")
}

model AssignmentRun {
  id        String   @id @default(cuid())
  weekOf    DateTime
  createdAt DateTime @default(now())

  flags AssignmentRunFlag[]

  @@map("assignment_runs")
}

model AssignmentRunFlag {
  id              String        @id @default(cuid())
  assignmentRunId String
  assignmentRun   AssignmentRun @relation(fields: [assignmentRunId], references: [id], onDelete: Cascade)
  agentId         String
  agent           User          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  reason          String
  leadsAssigned   Int           @default(0)
  createdAt       DateTime      @default(now())

  @@map("assignment_run_flags")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  payload   Json
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@map("notifications")
}

model TrainingModule {
  id          String   @id @default(cuid())
  title       String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons TrainingLesson[]

  @@index([order])
  @@map("training_modules")
}

model TrainingLesson {
  id          String   @id @default(cuid())
  moduleId    String
  module      TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title       String
  description String?
  videoUrl    String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  progress TrainingProgress[]

  @@index([moduleId, order])
  @@map("training_lessons")
}

model TrainingProgress {
  id          String         @id @default(cuid())
  agentId     String
  agent       User           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      TrainingLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime       @default(now())

  @@unique([agentId, lessonId])
  @@map("training_progress")
}

// --- Agent Portal ---

// Book of Business: a sold policy, "Submitted" (= pending with the carrier)
// until an agent flips it to "Issued" once the carrier approves it. leadId is
// optional — plenty of sales come from leads bought outside this system, so
// the client fields are always stored directly on the Policy rather than only
// derived from the linked Lead.
model Policy {
  id               String       @id @default(cuid())
  agentId          String?
  agent            User?        @relation("AgentPolicies", fields: [agentId], references: [id], onDelete: SetNull)
  leadId           String?
  lead             Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  clientName       String
  clientPhone      String?
  state            String?
  carrier          String
  product          String?
  annualPremium    Decimal      @db.Decimal(10, 2)
  status           PolicyStatus @default(SUBMITTED)
  submittedAt      DateTime     @default(now())
  issuedAt         DateTime?
  discordMessageId String?      @unique
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  statusHistory PolicyStatusHistory[]

  @@index([agentId])
  @@index([status])
  @@index([submittedAt])
  @@index([issuedAt])
  @@map("policies")
}

// Written on every Policy.status change going forward (no backfill for
// pre-existing rows) — powers the Book of Business status timeline and the
// Policy Status Analytics trend/conversion chart on the personal dashboard.
model PolicyStatusHistory {
  id          String        @id @default(cuid())
  policyId    String
  policy      Policy        @relation(fields: [policyId], references: [id], onDelete: Cascade)
  fromStatus  PolicyStatus?
  toStatus    PolicyStatus
  changedById String?
  changedBy   User?         @relation("PolicyStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  @@index([policyId, createdAt])
  @@map("policy_status_history")
}

// Personal goal tracking (spec: Goal Tracking System). One row per
// agent-created goal; achievedAt doubles as the "achievement history" record
// (a full Achievements/Badges catalog is a future phase, not built here).
model Goal {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    GoalCategory
  targetValue Decimal      @db.Decimal(12, 2)
  periodStart DateTime
  periodEnd   DateTime
  achievedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId, periodEnd])
  @@map("goals")
}

/// Team chat — channels, messages, and where each person left off.
///
/// Deliberately polled rather than socketed: a Vercel function cannot hold a
/// long-lived connection, and every other live surface in this app (dashboard,
/// leaderboard, notifications) already polls. One more poll on an indexed
/// table costs nothing and adds no service to a deployment.
model ChatChannel {
  id         String        @id @default(cuid())
  slug       String        @unique
  name       String
  topic      String?
  /// Lowest role that may read and post. Managers see MANAGER channels and
  /// below; agents see AGENT channels only. Ignored once `restricted` is set —
  /// an explicit member list takes over instead of the role tier.
  minRole    Role          @default(AGENT)
  /// When true, visibility is exactly the rows in `members` (plus anyone who
  /// can manage channels, so admins never lock themselves out of a room they
  /// created) — `minRole` no longer applies at all.
  restricted Boolean       @default(false)
  categoryId String?
  category   ChatCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  order      Int           @default(0)
  archived   Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  messages ChatMessage[]
  reads    ChatRead[]
  members  ChatChannelMember[]

  @@index([archived, order])
  @@index([categoryId])
  @@map("chat_channels")
}

model ChatMessage {
  id         String      @id @default(cuid())
  channelId  String
  channel    ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  /// Denormalised so a deleted agent's history still reads sensibly.
  authorName String
  body       String
  editedAt   DateTime?
  deletedAt  DateTime?
  pinnedAt   DateTime?
  pinnedById String?
  pinnedBy   User?       @relation("ChatPinnedBy", fields: [pinnedById], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())

  reactions ChatReaction[]

  /// The paging index: "everything in this channel after this id".
  @@index([channelId, createdAt])
  /// Pinned messages are read as their own short list, newest pin first.
  @@index([channelId, pinnedAt])
  @@map("chat_messages")
}

model ChatRead {
  id         String      @id @default(cuid())
  channelId  String
  channel    ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime    @default(now())

  @@unique([channelId, userId])
  @@index([userId])
  @@map("chat_reads")
}

/// A named group of channels in the rail, the way Discord stacks them.
///
/// Channels may sit outside every category; those render above the groups
/// rather than being forced into an "Uncategorised" bucket nobody named.
model ChatCategory {
  id        String   @id @default(cuid())
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channels ChatChannel[]

  @@index([order])
  @@map("chat_categories")
}

/// One person's one reaction of one emoji to one message.
///
/// Stored a row per person rather than a tally per emoji, because the useful
/// question is "did I already react, and who else did" — a counter cannot
/// answer either, and it drifts the moment a write is lost.
model ChatReaction {
  id        String      @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime    @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("chat_reactions")
}

/// One row per person explicitly granted access to a `restricted` channel.
/// Only meaningful when the channel's `restricted` flag is set — otherwise
/// visibility comes from `minRole` instead and this table isn't consulted.
model ChatChannelMember {
  id        String      @id @default(cuid())
  channelId String
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([channelId, userId])
  @@index([userId])
  @@map("chat_channel_members")
}
